{
    "name": "ainsley-clark/squidge",
    "description": "A Wordpress Plugin to compress and convert images using cwebp, jpegoptim and optipng.",
    "type": "plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Ainsley Clark",
            "email": "info@ainsleyclark.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "htmlburger/carbon-fields-plugin": "^3.3",
        "htmlburger/carbon-field-number": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Squidge\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Squidge\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
